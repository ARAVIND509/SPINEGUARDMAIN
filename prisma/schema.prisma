generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Patient {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId       String   @unique
  name            String
  age             Int?
  gender          String?
  contactNumber   String?
  medicalHistory  String?
  symptoms        String?
  createdAt       DateTime @default(now())
  
  scans           Scan[]
  appointments    Appointment[]
  doctorNotes     DoctorNote[]
  medications     Medication[]

  @@index([userId])
  @@map("patients")
}

model Appointment {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String
  status      String   @default("Scheduled")
  notes       String?

  @@index([patientId])
  @@map("appointments")
}

model DoctorNote {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  note        String
  createdAt   DateTime @default(now())

  @@index([patientId])
  @@map("doctor_notes")
}

model Medication {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name        String
  dosage      String
  frequency   String
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean  @default(true)

  @@index([patientId])
  @@map("medications")
}

model Scan {
  id            String     @id @default(uuid())
  patientCaseId String
  patient       Patient    @relation(fields: [patientCaseId], references: [id], onDelete: Cascade)
  imageUrl      String
  imageType     String
  metadata      Json?      
  uploadedAt    DateTime   @default(now())
  analyses      Analysis[]

  @@index([patientCaseId])
  @@map("scans")
}

model Analysis {
  id         String   @id @default(uuid())
  scanId     String
  scan       Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  results    Json     
  analyzedAt DateTime @default(now())

  @@index([scanId])
  @@map("analyses")
}

model User {
  id       String    @id @default(uuid())
  username String    @unique
  password String
  role     String    @default("reviewer")
  patients Patient[]

  @@map("users")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  details   Json?
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
